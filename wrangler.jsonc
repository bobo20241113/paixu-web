{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paixu-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "paixu-db", "database_id": "a74f0f85-3861-4d61-8554-e495adba7454", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
